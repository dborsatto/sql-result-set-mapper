{
    "name": "dborsatto/sql-result-set-mapper",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4",
        "psalm/plugin-phpunit": "^0.19.7",
        "vimeo/psalm": "^6.19"
    },
    "license": "MIT",
    "autoload": {
